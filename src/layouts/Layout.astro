---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { ProgressProviderWrapper } from "../components/ProgressProviderWrapper";

interface Props {
  title?: string;
}

const { title = "Web Dev Roadmap" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="A Duolingo-inspired interactive learning roadmap for Bangladeshi school students. Track your progress from Class 6 through HSC." />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <ProgressProviderWrapper client:load>
      <Navbar />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </ProgressProviderWrapper>
  </body>
</html>
